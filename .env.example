# URL canônica para QR Codes permanentes (em Vercel, pode ficar vazia:
# VERCEL_PROJECT_PRODUCTION_URL fornece o domínio estável de produção).
APP_URL=""

# Frontend Vite: URL e chave publishable (ou anon legada) públicas do Supabase
VITE_SUPABASE_URL="https://seu-projeto.supabase.co"
VITE_SUPABASE_ANON_KEY="sua-chave-anon-publica"

# Backend Express: use os mesmos valores públicos (nunca secret/service_role)
SUPABASE_URL="https://seu-projeto.supabase.co"
SUPABASE_ANON_KEY="sua-chave-anon-publica"

# Configure GEMINI_API_KEY se o recurso Gemini estiver habilitado
GEMINI_API_KEY=""
